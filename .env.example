# Copy to .env and fill in values
GUARDIAN_SMTP_HOST=smtp.gmail.com
GUARDIAN_SMTP_PORT=587
GUARDIAN_SMTP_USER=your@gmail.com
GUARDIAN_SMTP_PASSWORD=your-google-app-password
GUARDIAN_SMTP_FROM=Guardian AI <your@gmail.com>
GUARDIAN_APP_URL=http://localhost:4200
GUARDIAN_AUTH_DEV_CODES=0
GUARDIAN_RESEND_COOLDOWN_SECONDS=60

# Security (Tier 1)
GUARDIAN_ENV=development
GUARDIAN_JWT_SECRET=generate-a-random-32-char-string-here
GUARDIAN_JWT_EXPIRE_MINUTES=1440
GUARDIAN_MAX_FAILED_LOGIN=5
GUARDIAN_LOGIN_LOCKOUT_MINUTES=15
GUARDIAN_MAX_FAILED_VERIFY=5
GUARDIAN_VERIFY_LOCKOUT_MINUTES=15

# Database (PostgreSQL). Leave unset to fall back to the local SQLite file.
# scripts/setup_postgres.sh fills both of these in automatically.
GUARDIAN_DATABASE_URL=postgresql+psycopg://guardian:<password>@localhost:5432/guardian
# Fernet key that encrypts watchlist face photos + embeddings (keep secret, back it up)
GUARDIAN_DATA_KEY=

# Test account (operator@guardian.ai / Guardian1!) is created on startup in development
# and skipped in production. Set to 0 to turn it off in development too.
GUARDIAN_SEED_TEST_USER=1

# Models (optional — defaults shown)
GUARDIAN_YOLO_MODEL=yolo11n.pt
GUARDIAN_PERSON_MIN_CONFIDENCE=0.45
GUARDIAN_LIVE_REID=1
GUARDIAN_LIVE_REID_MODEL=osnet_ibn_x1_0
GUARDIAN_FACE_MODEL=ArcFace

#For AI Pipeline
# Path for testing the models
VIDEO_PATH=

# File path for saving checkpoints to continue working
CHECKPOINT_FILE=
